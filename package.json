{
  "name": "wisemoney",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first personal-finance PWA — AI guidance + financial literacy",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20 <21",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1.1.15": "1.1.16",
      "brace-expansion@2.1.1": "2.1.2",
      "brace-expansion@5.0.6": "5.0.8",
      "esbuild": "^0.28.1",
      "fast-uri": "3.1.4",
      "js-yaml": "4.3.0",
      "postcss": "^8.5.18"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @wisemoney/web dev",
    "build": "pnpm --filter @wisemoney/web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  }
}
