{
  "name": "wisemoney",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first personal-finance PWA — AI guidance + financial literacy",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20 <21",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<2": "1.1.18",
      "brace-expansion@>=2 <5": "2.1.4",
      "brace-expansion@>=5 <6": "5.0.9",
      "esbuild": "^0.28.1",
      "fast-uri": "3.1.5",
      "js-yaml": "4.3.1",
      "nanoid@>=3 <4": "3.3.17",
      "postcss": "^8.5.18"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @wisemoney/web dev",
    "build": "pnpm --filter @wisemoney/web build",
    "lint": "pnpm -r --if-present lint",
    "release:check": "node scripts/check-release.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  }
}
